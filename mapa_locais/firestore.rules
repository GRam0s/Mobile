rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }

    // Mesma lista de lib/services/auth_service.dart (emailsAdmin).
    function admin() {
      return logado() && request.auth.token.email in ['ramos04082005@gmail.com'];
    }

    // Locais: qualquer usuário logado lê; só administradores cadastram, editam e excluem.
    match /locais/{id} {
      allow read: if logado();
      allow delete: if admin();
      allow create, update: if admin() && localValido(request.resource.data);

      // Uma avaliação por usuário, gravada no documento com o próprio uid.
      match /avaliacoes/{uid} {
        allow read: if logado();
        allow create, update: if logado() && request.auth.uid == uid
          && avaliacaoValida(request.resource.data);
        allow delete: if logado() && (request.auth.uid == uid || admin());
      }
    }

    // Favoritos de cada usuário: só o dono lê e grava.
    match /usuarios/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['favoritos'])
        && request.resource.data.favoritos is list
        && request.resource.data.favoritos.size() <= 500;
    }

    // Todo o resto do banco fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function localValido(d) {
  return d.keys().hasOnly(['nome', 'categoria', 'cidade', 'avaliacao', 'distancia',
                           'horario', 'descricao', 'favorito', 'latitude', 'longitude'])
    && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 100
    && d.categoria is string && d.cidade is string
    && d.avaliacao is number && d.avaliacao >= 0 && d.avaliacao <= 5
    && d.distancia is number && d.distancia >= 0
    && d.horario is string && d.descricao is string && d.descricao.size() <= 1000
    && d.favorito is bool
    && d.get('latitude', 0) is number && d.get('longitude', 0) is number;
}

function avaliacaoValida(d) {
  return d.keys().hasOnly(['autor', 'nota', 'comentario'])
    && d.autor is string && d.autor.size() <= 100
    && d.nota is int && d.nota >= 1 && d.nota <= 5
    && d.comentario is string && d.comentario.size() <= 500;
}
